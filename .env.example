# SmartCare Environment Configuration
# Copy this file to .env to configure custom settings

# Django Settings
DJANGO_SECRET_KEY=django-insecure-smartcare-healthcare-app-key-2026
DJANGO_DEBUG=True

# Hospital Timezone (e.g. Asia/Kolkata, America/New_York, UTC)
HOSPITAL_TIMEZONE=Asia/Kolkata

# Default Hospital Destination Configuration
DEFAULT_HOSPITAL_NAME=SmartCare Central Hospital
DEFAULT_HOSPITAL_ADDRESS=100 Healthcare Blvd, Metro City
DEFAULT_HOSPITAL_LAT=12.971598
DEFAULT_HOSPITAL_LNG=77.594562

# Default Safety Buffer (Minutes)
DEFAULT_SAFETY_BUFFER_MINUTES=15

# Routing Service Provider: 'simulation', 'google', or 'mapbox'
# In 'simulation' mode, SmartCare operates 100% offline without any API keys.
ROUTING_PROVIDER=simulation

# External API Keys (Optional - keep empty to run in simulation mode)
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=
